# Directory that holds the builds/ folder. Defaults to the working directory, same as explorer_server.
# DATA_DIR=/data

# Comma separated list of channels to track. Defaults to "stable" (explorer_server only tracked stable).
# TRACK_CHANNELS=stable,canary

# How often to check x-build-id, in seconds. Equibot uses 30.
# POLL_INTERVAL_SECONDS=30

# How many chunk requests to run at once. Lower this on small servers.
# CHUNK_CONCURRENCY=8

# Build archives only when they are downloaded. Set this to true only if immediate archive availability is required.
# ARCHIVE_PREBUILD=false

# Limit the CPU and memory used when an archive is requested.
# ARCHIVE_THREADS=4
# ARCHIVE_COMPRESSION_LEVEL=3

# Cap on the module viewer cache. The least recently viewed builds are evicted first.
# MODULE_CACHE_MAX_GB=20

# Bearer token for POST /fixup-timestamps. The endpoint is disabled when unset.
# ADMIN_TOKEN=

# Use a system 7z instead of the one bundled with 7zip-bin.
# SEVEN_ZIP_PATH=/usr/bin/7z

# VendettaAPI base URL. When set, the scraper downloads the Hermes bundle of every new Discord Android version it reports.
# VENDETTA_API_URL=

# How often to poll VendettaAPI's /android/index, in seconds. The webhook below makes new builds show up sooner.
# VENDETTA_POLL_INTERVAL_SECONDS=300

# Receive VendettaAPI's new-release webhook on this port. Add http://scraper:8485/ to VendettaAPI's NOTIFY_WEBHOOK_URL
# and set this to its NOTIFY_WEBHOOK_SECRET. The listener is off when unset.
# VENDETTA_WEBHOOK_SECRET=
# VENDETTA_WEBHOOK_PORT=8485

# The compactor recompresses builds first seen more than this many days ago at the highest zstd level.
# COMPACT_AFTER_DAYS=30
