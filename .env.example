# Directory that holds the builds/ folder. Defaults to the working directory, same as explorer_server.
# DATA_DIR=/data

# Comma separated list of channels to track. Defaults to "stable" (explorer_server only tracked stable).
# TRACK_CHANNELS=stable,canary

# Set to "false" to only serve existing builds without polling Discord.
# TRACKER_ENABLED=true

# How often to check x-build-id, in seconds. Equibot uses 30.
# POLL_INTERVAL_SECONDS=30

# How many chunk requests to run at once. Equicord's lazy chunk loader uses 50.
# CHUNK_CONCURRENCY=50

# How many decoded bundles the UI keeps in memory. Each one is a few hundred MB.
# BUNDLE_CACHE_SIZE=2

# Bearer token for POST /fixup-timestamps. The endpoint is disabled when unset.
# ADMIN_TOKEN=

# Use a system 7z instead of the one bundled with 7zip-bin.
# SEVEN_ZIP_PATH=/usr/bin/7z
